{
    "configurations": [
        {
            "args": [
                "${workspaceFolder}/test/handmade/${input:HandmadeTestName}/code.cj",
                "-O2",
                "-j1",
            ],
            "cwd": "${workspaceFolder}/test/handmade/${input:HandmadeTestName}",
            "env": {
                "CANGJIE_HOME": "${workspaceFolder}/cangjie_compiler/output"
            },
            "name": "Handmade Test",
            "preLaunchTask": "source envsetup",
            "program": "${workspaceFolder}/cangjie_compiler/output/bin/cjc",
            "request": "launch",
            "type": "lldb"
        },
        {
            "args": [
                "${workspaceFolder}/test/wcet/${input:WcetTestName}/${input:WcetTestName}.cj",
                "-O2",
                "-j1",
            ],
            "cwd": "${workspaceFolder}/test/wcet/${input:WcetTestName}",
            "env": {
                "CANGJIE_HOME": "${workspaceFolder}/cangjie_compiler/output"
            },
            "name": "WCET Test",
            "preLaunchTask": "source envsetup",
            "program": "${workspaceFolder}/cangjie_compiler/output/bin/cjc",
            "request": "launch",
            "type": "lldb"
        },
        {
            "args": [
                "${workspaceFolder}/test/CangjieBench/${input:CangjieBenchId}.cj",
                "-O2",
                "-j1",
                "--output-type=staticlib",
            ],
            "cwd": "${workspaceFolder}/test/CangjieBench",
            "env": {
                "CANGJIE_HOME": "${workspaceFolder}/cangjie_compiler/output"
            },
            "name": "CangjieBench Test",
            "preLaunchTask": "source envsetup",
            "program": "${workspaceFolder}/cangjie_compiler/output/bin/cjc",
            "request": "launch",
            "type": "lldb"
        },
        {
            "args": [
                "${workspaceFolder}/test/flavors/${input:FlavorTestName}.cj",
                "-O2",
                "-j1",
            ],
            "cwd": "${workspaceFolder}/test/flavors",
            "env": {
                "CANGJIE_HOME": "${workspaceFolder}/cangjie_compiler/output"
            },
            "name": "Flavors Test",
            "preLaunchTask": "source envsetup",
            "program": "${workspaceFolder}/cangjie_compiler/output/bin/cjc",
            "request": "launch",
            "type": "lldb"
        }
    ],
    "inputs": [
        {
            "description": "Handmade Test case to run:",
            "id": "HandmadeTestName",
            "options": [
                "array",
                "call12",
                "default-args",
                "four",
                "i-plus-j",
                "i-plus-plus",
                "official",
                "readif",
                "return-compare",
                "return012",
                "while10",
                "x14",
            ],
            "type": "pickString"
        },
        {
            "description": "WCET Test case to run:",
            "id": "WcetTestName",
            "options": [
                "adpcm",
                "bs",
                "bsort100",
                "cnt",
                "compress",
                "cover",
                "crc",
                "duff",
                "edn",
                "expint",
                "fac",
                "fdct",
                "fft1",
                "fibcall",
                "fir",
                "insertsort",
                "janne_complex",
                "jfdctint",
                "lcdnum",
                "lms",
                "ludcmp",
                "matmult",
                "minver",
                "ndes",
                "ns",
                "nsichneu",
                "prime",
                "qsort-exam",
                "qurt",
                "recursion",
                "select",
                "sqrt",
                "st",
                "statemate",
                "ud"
            ],
            "type": "pickString"
        },
        {
            "description": "Number of the Cangjie Test case `x.cj`",
            "id": "CangjieBenchId",
            "type": "promptString"
        },
        {
            "description": "Flavor Test case to run:",
            "id": "FlavorTestName",
            "options": [
                "vanilla",
                "fudge",
                "fiore",
                "coffee",
                "blackcurrant"
            ],
            "type": "pickString"
        }
    ],
    "version": "0.2.0"
}