{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Handmade Test",
            "program": "${workspaceFolder}/cangjie_compiler/output/bin/cjc",
            "args": [
                "${workspaceFolder}/test/handmade/${input:HandmadeTestName}/code.cj",
                "-O2",
                "-j1",
            ],
            "cwd": "${workspaceFolder}/test/handmade/${input:HandmadeTestName}",
            "preLaunchTask": "source envsetup"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "WCET Test",
            "program": "${workspaceFolder}/cangjie_compiler/output/bin/cjc",
            "args": [
                "${workspaceFolder}/test/wcet/${input:WcetTestName}/${input:WcetTestName}.cj",
                "-O2",
                "-j1",
            ],
            "cwd": "${workspaceFolder}/test/wcet/${input:WcetTestName}",
            "preLaunchTask": "source envsetup"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "CangjieBench Test",
            "program": "${workspaceFolder}/cangjie_compiler/output/bin/cjc",
            "args": [
                "${workspaceFolder}/test/CangjieBench/${input:CangjieBenchId}.cj",
                "-O2",
                "-j1",
                "--output-type=staticlib",
            ],
            "cwd": "${workspaceFolder}/test/CangjieBench",
            "preLaunchTask": "source envsetup"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Flavors Test",
            "program": "${workspaceFolder}/cangjie_compiler/output/bin/cjc",
            "args": [
                "${workspaceFolder}/test/flavors/${input:FlavorTestName}.cj",
                "-O2",
                "-j1",
            ],
            "cwd": "${workspaceFolder}/test/flavors",
            "preLaunchTask": "source envsetup"
        }
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "HandmadeTestName",
            "description": "Handmade Test case to run:",
            "options": [ "array", "call12", "default-args", "four", "i-plus-j",
                "i-plus-plus", "official", "readif", "return-compare",
                "return012", "while10", "x14",
            ]
        },
        {
            "type": "pickString",
            "id": "WcetTestName",
            "description": "WCET Test case to run:",
            "options": [ "adpcm", "bs", "bsort100", "cnt", "compress", "cover",
                "crc", "duff", "edn", "expint", "fac", "fdct", "fft1",
                "fibcall", "fir", "insertsort", "janne_complex", "jfdctint",
                "lcdnum", "lms", "ludcmp", "matmult", "minver", "ndes", "ns",
                "nsichneu", "prime", "qsort-exam", "qurt", "recursion",
                "select", "sqrt", "st", "statemate", "ud"
            ]
        },
        {
            "type": "promptString",
            "id": "CangjieBenchId",
            "description": "Number of the Cangjie Test case `x.cj`"
        },
        {
            "type": "pickString",
            "id": "FlavorTestName",
            "description": "Flavor Test case to run:",
            "options": [ "vanilla", "fudge", "fiore", "coffee", "blackcurrant" ]
        }
    ]
}