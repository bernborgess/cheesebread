        Bitlist[active_EINKLEMMSCHUTZ_CTRL_copy_IDX] = 1
        Bitlist[active_BLOCK_ERKENNUNG_CTRL_copy_IDX] = 1
        Bitlist[active_FH_TUERMODUL_CTRL_copy_IDX] = 1
