            Bitlist[entered_EINSCHALTSTROM_MESSEN_BLOCK_ERKENNUNG_CTRL_IDX] = 0
            BLOCK_ERKENNUNG_CTRL_BLOCK_ERKENNUNG_CTRL_next_state = 1
