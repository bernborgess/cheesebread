func swi10(c: Int64): Int64 {
    var cVar: Int64 = c
    for (i in 0..10) {
        match (i) {
            case 0 => cVar += 1
            case 1 => cVar += 1
            case 2 => cVar += 1
            case 3 => cVar += 1
            case 4 => cVar += 1
            case 5 => cVar += 1
            case 6 => cVar += 1
            case 7 => cVar += 1
            case 8 => cVar += 1
            case 9 => cVar += 1
            case _ => cVar -= 1
        }
    }
    return cVar
}


main(): Int64 {
    var cnt: Int64 = 0

    cnt = swi10(cnt)
    cnt = swi50(cnt)
    cnt = swi120(cnt)

    /* printf("cnt: %d\n", cnt); */

    return cnt
}
